=========== Member Initialization Order
Code Example 3: Constructor Initialization without Initializer List
// Online C++ compiler (editor)
// Write and run C++ online using this editor.

#include <iostream>
using namespace std;
class Test
{
    public:
        Test()
        {
            cout<<"default"<<endl;
            //the default constructor of Test is called first, 
        }

        Test(int x)
        {
            cout<<"parameterized"<<endl;
            //followed by the parameterized constructor.
        }

    //The member is initialized twice, leading to performance inefficiencies.
};

class Main
{
    public:
        Test t; //The Main class contains an object of Test.


        Main()
        {
            t=Test(105);  //In its constructor, t is assigned a new value.
        }
};
int main() {
    // Write C++ code here
    Main m;
    
    return 0;
}
