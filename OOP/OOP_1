parameterized

================Constructor with Initializer List
// Online C++ compiler (editor)
// Write and run C++ online using this editor.

#include <iostream>
using namespace std;
class Test
{
    public:
        Test(int x){
            cout<<"parameterized"<<x<<endl;
        }
};

class Main
{
   public:
    Test t;

    Main():t(10){}; // the Main class uses an initializer list to initialize the Test object t.
    //The member t is initialized directly, avoiding the overhead of default initialization followed by assignment.
    
};
int main() {
    // Write C++ code here
    Main m;
    
    return 0;
}
